#
# Import the Solr CronJob Trigger configuration for the Jakes Product Catalog
#

INSERT_UPDATE Trigger;cronJob(code)[unique=true];second;minute;hour;day;month;year;relative;active;maxAcceptableDelay

# Run the full-jakesIndex-cronJob at 3:05 AM every day
;full-jakesIndex-cronJob;0;5;3;-1;-1;-1;false;false;-1

# Run the update-jakesIndex-cronJob every 1 minutes
;update-jakesIndex-cronJob;0;1;-1;-1;-1;-1;true;false;-1
